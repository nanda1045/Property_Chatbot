APP_ENV=local
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=aker_chatbot
MYSQL_CONNECT_TIMEOUT_SECONDS=5

CHROMA_PATH=Data/chroma
CHROMA_COLLECTION=property_chunks
BM25_PATH=Data/retrieval/bm25.sqlite3
UNSTRUCTURED_CHUNKS_PATH=Data/unstructured/property_chunks.jsonl
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_PATH=Data/models/sentence-transformers

DEFAULT_PROPERTY_CODE=115r
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-haiku-4-5-20251001

# Authentication defaults to a recruiter-friendly local identity. Production requires entra.
AUTH_MODE=local
LOCAL_AUTH_USER_ID=local-user
LOCAL_AUTH_DISPLAY_NAME=Local Demo User
LOCAL_AUTH_EMAIL=local-user@example.test
LOCAL_AUTH_ROLE=PropertyManager
LOCAL_AUTH_ALLOWED_PROPERTIES=["*"]

# Required only when AUTH_MODE=entra. ENTRA_API_AUDIENCE is the backend API client ID.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
ENTRA_JWKS_CACHE_SECONDS=3600

# Entra property grants keyed by object ID and/or app role. Unmapped identities are denied.
AUTH_PROPERTY_ACCESS={}

AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_PLANNER_RETRIES=2
AGENT_MAX_SQL_APPROVALS=1
AGENT_MAX_RUN_SECONDS=60

STREAM_QUEUE_MAX_SIZE=128
STREAM_POLL_INTERVAL_SECONDS=0.25
STREAM_HEARTBEAT_SECONDS=10
STREAM_THREAD_JOIN_SECONDS=5

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
